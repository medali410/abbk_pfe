# Copier vers .env et remplir les valeurs (ne pas committer .env)
MONGO_URI=mongodb://127.0.0.1:27017/dali_pfe
JWT_SECRET=changez-moi-en-production
JWT_EXPIRES=7d
GEMINI_API_KEY=
ML_SERVER=http://localhost:5000
# Service Python (uvicorn ai_service) — non lu par Node ; à mettre dans l’environnement du terminal qui lance uvicorn :
# USE_TABULAR=1
# TABULAR_ARTIFACTS_DIR=../modele_moteur_ia_inspect/models_tabular
MODEL_METRICS_FILE=
STOP_THRESHOLD=75
TEMP_CRITICAL=85

# Envoi optionnel des identifiants client par email (provision demande d'achat)
# Sans SMTP_HOST, aucun email n'est envoye (les identifiants restent dans la reponse API).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# URL affichee dans le mail (page de connexion Flutter Web)
APP_LOGIN_URL=http://localhost:50666/#/login

# OAuth Google (Flutter google_sign_in -> backend verifyIdToken)
# Utiliser le Web Client ID Google OAuth 2.0
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# URL publique du frontend Flutter Web (utilisée comme retour OAuth)
APP_WEB_URL=http://localhost:50924
# Optionnel: callback explicite (sinon déduit automatiquement)
# GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback

# Emails (séparés par virgule) en plus du défaut serveur : si un MaintenanceAgent existe,
# la connexion email/mot de passe en tant que technicien (User ou collection technicians) renvoie le rôle maintenance.
# MAINTENANCE_LOGIN_EMAIL_ALIASES=autre@example.com






