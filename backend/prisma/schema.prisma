generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  nom       String
  adresse   String   @default("")
  role      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  admin            Admin?
  client           Client?
  concepteur       Concepteur?
  technician       Technician?
  maintenanceAgent MaintenanceAgent?
}

model Admin {
  id     Int  @id @default(autoincrement())
  userId Int  @unique
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Client {
  id            Int     @id @default(autoincrement())
  userId        Int     @unique
  clientId      String  @unique
  motorType     String  @default("Général")
  location      String  @default("")
  loginDisabled Boolean @default(false)
  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Concepteur {
  id         Int      @id @default(autoincrement())
  userId     Int      @unique
  companyId  String   @default("")
  location   String   @default("")
  specialite String   @default("")
  machineIds String   @default("[]")
  imageUrl   String   @default("")
  phone      String   @default("")
  city       String   @default("")
  country    String   @default("")
  websiteUrl String   @default("")
  profileUrl String   @default("")
  status     String   @default("Actif")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Technician {
  id            Int    @id @default(autoincrement())
  userId        Int    @unique
  technicianId  String @unique
  companyId     String @default("")
  firstName     String @default("")
  lastName      String @default("")
  specialization String @default("")
  status        String @default("Disponible")
  machineIds    String @default("[]")
  user          User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MaintenanceAgent {
  id                  Int    @id @default(autoincrement())
  userId              Int    @unique
  maintenanceAgentId  String @unique
  clientId            String @default("")
  firstName           String @default("")
  lastName            String @default("")
  machineIds          String @default("[]")
  user                User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Machine {
  id          String   @id
  name        String
  price       String   @default("")
  stock       Int      @default(0)
  type        String   @default("")
  aiType      String   @default("M")
  disponible  Boolean  @default(true)
  status      String   @default("STOPPED")
  companyId   String   @default("")
  motorType   String   @default("air_cooled")
  location    String   @default("")
  imageUrl    String   @default("")
  isPublic    Boolean  @default(true)
  concepteurId       String   @default("")
  clientId           String   @default("")
  technicianId       String   @default("")
  maintenanceAgentId String   @default("")
  model3dUrl  String   @default("")
  modele3dId  Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  wifiSsid     String   @default("")
  wifiPassword String   @default("") // Temporaire PFE
  baseIp       String   @default("192.168.1") // Préfixe IP pour les instances
  modele3d          Modele3d?
  controles         Controle[]
  maintenanceOrders MaintenanceOrder[]
  predictions       Prediction[]
  securityIncidents SecurityIncident[]
  instances         MachineInstance[]

}

/// Instance physique unique d'une machine (1 machine physique = 1 MachineInstance)
model MachineInstance {
  id           String    @id           // ex: MAC-54326404-001
  modelId      String                  // référence vers Machine (catalogue)
  ipAddress    String    @default("")  // ex: 192.168.1.101
  clientId     String    @default("")  // propriétaire actuel
  concepteurId String    @default("")  // concepteur fabricant
  status       String    @default("STOPPED") // RUNNING, STOPPED, STOPPED_DANGER
  wifiSsid     String    @default("")
  wifiPassword String    @default("")
  purchasedAt  DateTime?               // date d'achat par le client
  activatedAt  DateTime?               // date de mise en service
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  model        Machine   @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@index([modelId])
  @@index([clientId])
}

model Modele3d {
  id          Int      @id @default(autoincrement())
  name        String
  description String   @default("")
  photoUrl    String   @default("")
  machineId   String   @unique
  materiels   String   @default("[]")
  createdById Int?
  machine     Machine  @relation(fields: [machineId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Plans, schémas, rapports (distinct des modèles 3D).
model Document {
  id            Int      @id @default(autoincrement())
  documentId    String   @unique
  name          String
  version       String   @default("v1.0")
  documentType  String   @default("")
  clientId      String   @default("")
  status        String   @default("Actif")
  securityEmail String   @default("")
  passwordHash  String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Telemetry {
  id        Int      @id @default(autoincrement())
  machineId String
  temp      Float    @default(0.0)
  voltage   Float    @default(0.0)
  vibration Float    @default(0.0)
  magnet    Float    @default(0.0)
  presence  Int      @default(0)
  rpm       Int      @default(0)
  torque    Float    @default(0.0)
  courant   Float    @default(0.0)
  puissance Float    @default(0.0)
  infrared  Float    @default(0.0)
  timestamp DateTime @default(now())
}

model ChatRoom {
  id           Int                   @id @default(autoincrement())
  roomId       String                @unique
  name         String?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  messages     ChatMessage[]
  participants ChatRoomParticipant[]
}

model ChatMessage {
  id             Int      @id @default(autoincrement())
  roomId         String
  chatRoom       ChatRoom @relation(fields: [roomId], references: [roomId], onDelete: Cascade)
  from           String   // role
  senderName     String
  text           String
  attachmentUrl  String?
  attachmentType String?
  createdAt      DateTime @default(now())
}

model ChatRoomParticipant {
  id       Int      @id @default(autoincrement())
  roomId   String
  chatRoom ChatRoom @relation(fields: [roomId], references: [roomId], onDelete: Cascade)
  userId   Int
  role     String   // "technician", "client", "conception", "admin"
  userName String   @default("")
  joinedAt DateTime @default(now())
  isPinned Boolean  @default(false)
  isMuted  Boolean  @default(false)

  @@unique([roomId, userId])
}

model UserBlock {
  id        Int      @id @default(autoincrement())
  blockerId Int
  blockedId Int
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
}

model PurchaseRequest {
  id             Int      @id @default(autoincrement())
  machineId      String
  machineName    String   @default("")
  linkedClientId String   @default("")
  requesterName  String
  requesterEmail String   @default("")
  requesterPhone String   @default("")
  location       String   @default("")
  googleMapsUrl  String   @default("")
  note           String   @default("")
  status         String   @default("PENDING") // PENDING, APPROVED, REJECTED
  reviewedByName String   @default("")
  requestType    String   @default("PURCHASE")
  metadata       String   @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Controle {
  id           Int      @id @default(autoincrement())
  machineId    String
  machine      Machine  @relation(fields: [machineId], references: [id], onDelete: Cascade)
  technicienId String?
  technicienNom String?
  jour         String   // Format YYYY-MM-DD
  compteRendu  String   @default("")
  statut       String   @default("EN_ATTENTE") // EN_ATTENTE, EN_COURS, TERMINE, ANNULE
  notes        String   @default("")
  type         String   @default("TERRAIN") // TERRAIN, CALENDRIER, PREVENTIF
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model MaintenanceOrder {
  id             String   @id @default(uuid())
  machineId      String
  machine        Machine  @relation(fields: [machineId], references: [id], onDelete: Cascade)
  description    String
  technicianId   String?
  technicianName String?
  status         String   @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Mission {
  id          Int       @id @default(autoincrement())
  missionId   String    @unique
  technicianId String
  machineId   String
  machineName String    @default("")
  title       String
  description String    @default("")
  priority    String    @default("NORMAL")
  status      String    @default("PENDING")
  scheduledAt DateTime?
  completedAt DateTime?
  createdById Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Consultation {
  id                 Int       @id @default(autoincrement())
  consultationId     String    @unique
  machineId          String
  technicianId       String
  scheduledDate      DateTime
  durationMinutes    Int       @default(60)
  note               String    @default("")
  clientId           String    @default("")
  maintenanceAgentId String    @default("")
  status             String    @default("PENDING")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model Notification {
  id             Int       @id @default(autoincrement())
  userId         Int
  role           String
  type           String    @default("INFO")
  title          String    @default("")
  body           String    @default("")
  missionId      Int?
  consultationId Int?
  isRead         Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Prediction {
  id             Int      @id @default(autoincrement())
  machineId      String
  status         String
  riskPercentage Int
  typePanne      String   @default("NORMAL")
  diagnostic     String   @default("")
  recommandation String   @default("")
  urgence        String   @default("faible")
  rulCycles      Float?
  scenarioScores String   @default("{}")
  createdAt      DateTime @default(now())

  machine        Machine  @relation(fields: [machineId], references: [id], onDelete: Cascade)

  @@index([machineId])
  @@index([status])
  @@index([createdAt])
}

model SecurityIncident {
  id             Int      @id @default(autoincrement())
  machineId      String
  sensor         String
  measuredValue  Float
  threshold      Float
  timestamp      DateTime @default(now())
  resolved       Boolean  @default(false)
  resolvedBy     String?
  machine        Machine  @relation(fields: [machineId], references: [id], onDelete: Cascade)

  @@index([machineId])
  @@index([timestamp])
}
